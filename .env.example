OPENAI_API_KEY=
OWNER_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
PORT=8080
# Job API auth (comma list of bot tokens; generate on the server, never commit)
TRANSCRIPT_API_TOKENS=
TRANSCRIPT_SESSION_SECRET=
TRANSCRIPT_AUTH_MODE=enforce
# Long audio
MEDIA_DOWNLOAD_TIMEOUT_SECONDS=1800
CHUNK_TIMEOUT_SECONDS=1800
JOB_MAX_SECONDS=14400
MAX_CONCURRENT_LONG_JOBS=1
MAX_ACTIVE_PAGE_JOBS_PER_IP=2
# Peers whose CF-Connecting-IP / X-Forwarded-For are trusted for the per-IP cap (cloudflared = loopback).
TRUSTED_PROXY_IPS=127.0.0.1,::1
MAX_QUEUED_PAGE_JOBS=5
